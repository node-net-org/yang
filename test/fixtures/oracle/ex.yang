module ex {
  yang-version 1.1;
  namespace "urn:ex";
  prefix ex;
  import ietf-yang-metadata { prefix md; }
  import ex-ids { prefix ids; }

  md:annotation note { type string; }
  md:annotation weight { type uint16; }
  md:annotation big { type int64; }

  identity local-thing { base ids:thing; }

  typedef percent {
    type uint8 { range "0..100"; }
    default 50;
    units percent;
  }

  container c {
    leaf s { type string; }
    leaf i8 { type int8; }
    leaf u32 { type uint32; }
    leaf i64 { type int64; }
    leaf u64 { type uint64; }
    leaf d { type decimal64 { fraction-digits 3; } }
    leaf bool { type boolean; }
    leaf e { type empty; }
    leaf en { type enumeration { enum up; enum down; } }
    leaf b { type bits { bit one { position 0; } bit two { position 1; } bit three { position 2; } } }
    leaf bin { type binary; }
    leaf idr { type identityref { base ids:thing; } }
    leaf ii { type instance-identifier; }
    leaf u { type union { type int32; type string; } }
    leaf u2 { type union { type uint64; type enumeration { enum unlimited; } } }
    leaf lr { type leafref { path "../l/k1"; } }
    leaf-list ll { type uint8; }
    leaf-list lls { type string; ordered-by user; }
    anydata ad;
    anyxml ax;
    list l {
      key "k1 k2";
      leaf v { type string; }
      leaf k1 { type string; }
      leaf k2 { type uint8; }
      container inner { leaf x { type string; } }
      action reset { output { leaf ok { type boolean; } } }
    }
    list ids {
      key id;
      leaf id { type identityref { base ids:thing; } }
    }
    choice ch {
      case a { leaf ca { type string; } }
      leaf cb { type string; }
    }
    container p { presence "enabled"; leaf q { type string; } }
    action act {
      input { leaf x { type string; } leaf y { type uint8; } }
      output { leaf out { type string; } }
    }
    notification n { leaf z { type string; } }
  }
  container state { config false; leaf counter { type uint64; } }
  container settings {
    leaf level { type percent; description "How full."; }
    leaf mode { type enumeration { enum fast; enum safe { description "Slow but sure."; } } default safe; }
    leaf-list tags { type string; min-elements 1; }
    leaf ref { type leafref { path "/ex:c/l/ex:k1"; } }
  }
  list top { key name; leaf name { type string; } }
  rpc r {
    input { leaf b { type uint64; } leaf a { type string; } }
    output { leaf o { type string; } }
  }
  notification ev { leaf q { type string; } }
}
