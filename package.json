{
  "name": "@node-net/yang",
  "version": "0.1.1",
  "description": "YANG (RFC 7950) parser, compiler and data codecs for Node.js: XML, RFC 7951 JSON, schema queries",
  "keywords": [
    "yang",
    "rfc7950",
    "rfc7951",
    "netconf",
    "restconf",
    "network-automation"
  ],
  "author": "Mark Abrahams <mark@abrahams.co.nz>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-net-org/yang.git"
  },
  "homepage": "https://github.com/node-net-org/yang#readme",
  "bugs": {
    "url": "https://github.com/node-net-org/yang/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "modules",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && node scripts/gen-builtin-modules.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:require": "node scripts/require-smoke.cjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke:require && npm run portable:check && npm run pack:check && npm run audit:runtime",
    "portable:check": "node scripts/portable-check.mjs",
    "pack:check": "node scripts/pack-check.cjs",
    "check:full": "scripts/check-full.sh",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "deps:report": "node scripts/deps-report.mjs"
  },
  "dependencies": {
    "@rgrove/parse-xml": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "rolldown": "^1.2.16",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
